<div data-glpi-share-popover
     data-glpi-itemtype="{{ itemtype }}"
     data-glpi-items-id="{{ id }}"
     {{ token ? 'data-glpi-token-id=' ~ token.id : '' }}
>
    {# "Publish to web" toggle row #}
    <div class="d-flex align-items-start gap-2">
        <i class="ti ti-world text-secondary mt-1"></i>
        <div class="flex-grow-1">
            <label class="form-check-label fw-medium" for="share-publish-toggle-{{ id }}">
                {{ __('Publish to web') }}
            </label>
            <div class="text-secondary small">
                {{ __('Anyone with the link can view this article') }}
            </div>
        </div>
        <div class="form-check form-switch mb-0 ms-auto">
            <input class="form-check-input"
                   type="checkbox"
                   role="switch"
                   id="share-publish-toggle-{{ id }}"
                   aria-label="{{ __('Publish to web') }}"
                   {{ is_published ? 'checked' : '' }}
                   {{ not can_edit ? 'disabled' : '' }}
                   data-glpi-share-toggle>
        </div>
    </div>

    {# Link row (only when published) #}
    {% if is_published and token %}
        {% set share_url = config('url_base') ~ '/Share/' ~ token.token %}
        <div class="d-flex align-items-center gap-1 mt-2" data-glpi-share-link-row>
            <div class="input-icon cursor-pointer flex-grow-1"
                 data-glpi-clipboard-text="{{ share_url }}"
                 data-bs-toggle="tooltip"
                 data-bs-placement="top"
                 title="{{ __('Click to copy to clipboard') }}">
                <input type="text"
                       class="form-control form-control-sm cursor-pointer"
                       readonly
                       value="{{ share_url }}"
                       aria-label="{{ __('Public share link') }}"
                       data-glpi-share-url>
                <span class="input-icon-addon">
                    <i class="ti ti-copy"></i>
                </span>
            </div>
            {% if can_edit %}
                <button type="button"
                        class="btn btn-ghost-secondary btn-sm btn-icon"
                        data-glpi-share-regenerate
                        title="{{ __('Regenerate link') }}"
                        aria-label="{{ __('Regenerate link') }}"
                        data-bs-toggle="tooltip">
                    <i class="ti ti-refresh"></i>
                </button>
            {% endif %}
        </div>
    {% endif %}
</div>
