<div data-glpi-share-popover
     data-glpi-itemtype="{{ itemtype }}"
     data-glpi-items-id="{{ id }}"
     {{ token ? 'data-glpi-token-id=' ~ token.id : '' }}
>
    {# "Publish to web" toggle row #}
    <div class="d-flex align-items-start gap-2">
        <i class="ti ti-world text-secondary mt-1"></i>
        <div class="flex-grow-1">
            <label class="form-check-label fw-medium" for="share-publish-toggle-{{ id }}">
                {{ __('Publish to web') }}
            </label>
            <div class="text-secondary small">
                {{ __('Anyone with the link can view this article') }}
            </div>
        </div>
        <div class="form-check form-switch mb-0 ms-auto">
            <input class="form-check-input"
                   type="checkbox"
                   role="switch"
                   id="share-publish-toggle-{{ id }}"
                   aria-label="{{ __('Publish to web') }}"
                   {{ is_published ? 'checked' : '' }}
                   {{ not can_edit ? 'disabled' : '' }}
                   data-glpi-share-toggle>
        </div>
    </div>

    {# Link row (only when published) #}
    {% if is_published and token %}
        {% set slug = token.name %}
        {% set share_prefix = config('url_base') ~ '/Share/' %}
        {% set share_url = share_prefix ~ (slug ? slug ~ '-' : '') ~ token.token %}
        <div class="mt-2"
             data-glpi-share-link-row
             data-glpi-share-url="{{ share_url }}">
            <div class="input-group input-group-sm flex-nowrap">
                <span class="input-group-text text-muted text-truncate">{{ share_prefix }}</span>
                {% if can_edit %}
                    <input type="text"
                           class="form-control"
                           value="{{ slug }}"
                           data-glpi-share-slug
                           aria-label="{{ __('Public link slug') }}"
                           autocomplete="off"
                           autocapitalize="off"
                           spellcheck="false">
                {% else %}
                    <input type="text"
                           class="form-control"
                           value="{{ slug }}"
                           readonly
                           aria-label="{{ __('Public link slug') }}">
                {% endif %}
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-glpi-clipboard-text="{{ share_url }}"
                        title="{{ __('Copy link') }}"
                        aria-label="{{ __('Copy link') }}"
                        data-bs-toggle="tooltip">
                    <i class="ti ti-copy"></i>
                </button>
                {% if can_edit %}
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-glpi-share-regenerate
                            title="{{ __('Regenerate link') }}"
                            aria-label="{{ __('Regenerate link') }}"
                            data-bs-toggle="tooltip">
                        <i class="ti ti-refresh"></i>
                    </button>
                {% endif %}
            </div>
            <div class="text-danger small mt-1 d-none" data-glpi-share-slug-error>
                {{ __('Only lowercase letters, digits and dashes allowed') }}
            </div>
        </div>
    {% endif %}
</div>
