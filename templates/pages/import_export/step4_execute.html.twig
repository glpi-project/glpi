{% extends "pages/import_export/layout.html.twig" %}

{% block content_body %}
    <div class="card">
        <div class="card-header py-3 px-4">
            <h3 class="card-title">{{ __("Import results") }}</h3>
        </div>
        <table class="table table-card mb-0" data-testid="import-results">
            <thead>
                <tr>
                    <th class="w-70 px-4">{{ itemtype|itemtype_name }}</th>
                    <th class="w-30 px-4">{{ __("Status") }}</th>
                </tr>
            </thead>
            <tbody>
                {% for item in results.getImportedItems() %}
                    <tr>
                        <td class="w-70 px-4">{{ get_item_link(item) }}</td>
                        <td class="w-30 px-4">
                            <div class="d-flex align-items-center">
                                <i class="ti ti-check text-success me-2" aria-hidden="true"></i>
                                <span>{{ __("Imported") }}</span>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                {% for item_name, error in results.getFailedImports() %}
                    <tr>
                        <td class="w-70 px-4">{{ item_name }}</td>
                        <td class="w-30 px-4">
                            <div class="d-flex align-items-center">
                                <i class="ti ti-x text-danger me-2" aria-hidden="true"></i>
                                <span>{{ __("Not imported") }}</span>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="row mt-3">
        <div class="col">
            <div class="justify-content-end d-flex">
                <a href="{{ path(urls.index) }}" class="btn btn-outline-secondary">
                    {{ __("Import another file") }}
                </a>
            </div>
        </div>
    </div>
{% endblock content_body %}
