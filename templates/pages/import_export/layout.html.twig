{% extends "layout/page_without_tabs.html.twig" %}

{% set container_size = "narrow" %}

{% block content_title %}
    {{ __('Import') }} - {{ itemtype|itemtype_name(get_plural_number()) }}
{% endblock content_title %}

{% macro replacements_inputs(replacements) %}
    {% for replacement in replacements %}
        <input type="hidden" name="replacements[{{ loop.index0 }}][itemtype]" value="{{ replacement.itemtype }}"/>
        <input type="hidden" name="replacements[{{ loop.index0 }}][original_name]" value="{{ replacement.original_name }}"/>
        <input type="hidden" name="replacements[{{ loop.index0 }}][replacement_id]" value="{{ replacement.replacement_id }}"/>
    {% endfor %}
{% endmacro %}
