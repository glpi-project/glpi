{% extends "pages/import_export/layout.html.twig" %}
{% import "pages/import_export/layout.html.twig" as wizard %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block content_body %}
    <form method="POST" action="{{ path(urls.preview) }}">
        <div class="card">
            <div class="card-header py-3 px-4">
                <h3 class="card-title">{{ __("Resolve issues") }}</h3>
            </div>
            <table class="table table-card mb-0">
                <thead>
                    <tr>
                        <th class="w-30 px-4">{{ __("Itemtype") }}</th>
                        <th class="w-20 px-4">{{ __("Original value") }}</th>
                        <th class="w-50 px-4">{{ __("Replacement value") }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for issue in issues %}
                        {% set original_name = issue.default_name ?? issue.name %}
                        {% set replacement_index = loop.index0 + replacements|length %}
                        <tr>
                            <td class="px-4 align-middle">
                                <div class="d-flex align-items-center">
                                    <i class="me-2 {{ issue.itemtype|itemtype_icon }}" aria-hidden="true"></i>
                                    <span>{{ issue.itemtype|itemtype_name }}</span>
                                </div>
                            </td>
                            <td class="px-4 align-middle">
                                <span>{{ original_name }}</span>
                            </td>
                            <td class="px-4">
                                <input type="hidden" name="replacements[{{ replacement_index }}][itemtype]" value="{{ issue.itemtype }}"/>
                                <input type="hidden" name="replacements[{{ replacement_index }}][original_name]" value="{{ original_name }}"/>
                                {{ fields.dropdownField(
                                    issue.itemtype,
                                    'replacements[' ~ replacement_index ~ '][replacement_id]',
                                    issue.replacement_id|default(issue.itemtype == 'Entity' ? session('glpiactive_entity') : 0),
                                    '',
                                    {
                                        'field_class': 'col-12',
                                        'aria_label' : __("Replacement value for '%s'")|format(original_name),
                                        'no_label'   : true,
                                        'right'      : 'all',
                                        'mb'         : '',
                                    }
                                ) }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="row mt-3">
            <div class="col">
                <div class="justify-content-end d-flex">
                    <button type="submit" class="btn btn-primary">
                        {{ __("Preview import") }}
                    </button>
                </div>
            </div>
        </div>

        <input type="hidden" name="json" value="{{ json }}"/>
        {% for skipped_item in skipped_items %}
            <input type="hidden" name="skipped_items[]" value="{{ skipped_item }}" />
        {% endfor %}
        {{ wizard.replacements_inputs(replacements) }}
    </form>
{% endblock content_body %}
