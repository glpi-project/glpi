{% extends 'layout/page_card_notlogged.html.twig' %}

{% block logo_block %}
   <a href="{{ index_path() }}" title="{{ __('Home') }}">
      <span class="glpi-logo mb-4" title="GLPI"></span>
   </a>
{% endblock %}

{% block header_block %}
   <span class="card-title">{{ __('Re-authentication required') }}</span>
{% endblock %}

{% block content_block %}
   {% if failed ?? false %}
       <twig:Alert:Danger :heading="__('Authentication failure')" />
   {% endif %}

  <form method="{{ verify_http_method }}" action="{{ verify_url }}" data-submit-once autocomplete="off">
     <div class="mb-3">
        <label class="form-label">{{ label }}</label>
        {% include template %}
     </div>

     <div class="d-flex justify-content-end gap-2">

         {# cancel button #}
        <a href="{{ cancel_url }}" class="btn btn-outline-secondary">{{ __('Cancel') }}</a>

         {# submit/verify button #}
        <button type="submit" class="btn btn-primary">{{ __('Verify') }}</button>

     </div>
  </form>

{% endblock %}

