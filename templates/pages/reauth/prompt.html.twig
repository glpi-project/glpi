{% extends 'layout/page_card_notlogged.html.twig' %}

{% block logo_block %}
   <a href="{{ index_path() }}" title="{{ __('Home') }}">
      <span class="glpi-logo mb-4" title="GLPI"></span>
   </a>
{% endblock %}

{% block header_block %}
   <span class="card-title">{{ __('Re-authentication required') }}</span>
{% endblock %}

{% block content_block %}
   {% if failed ?? false %}
       <twig:Alert:Danger :title="__('Authentication failure')" />
   {% endif %}

   {% if is_redirect ?? false %}

      {# Redirect-based strategy (e.g. OAuth): verification happens out-of-band. #}
      {# The included fragment renders its own link to `reauth_url`; there is no #}
      {# secret to type and thus no form posted to the verify endpoint. #}
      <div class="mb-3">
         <label class="form-label">{{ label }}</label>
         {% include template %}
      </div>

      <div class="d-flex justify-content-end gap-2">
         <a href="{{ cancel_url }}" class="btn btn-outline-secondary">{{ __('Cancel') }}</a>
      </div>

   {% else %}

      <form method="post" action="{{ action }}" data-submit-once autocomplete="off">
         <input type="hidden" name="redirect" value="{{ redirect }}" />

         <div class="mb-3">
            <label class="form-label">{{ label }}</label>
            {% include template %}
         </div>

         <div class="d-flex justify-content-end gap-2">

             {# cancel button #}
            <a href="{{ cancel_url }}" class="btn btn-outline-secondary">{{ __('Cancel') }}</a>

             {# submit/verify button #}
            <button type="submit" class="btn btn-primary">{{ __('Verify') }}</button>

         </div>
      </form>

   {% endif %}
{% endblock %}

