{% extends "generic_show_form.html.twig" %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% set params  = params ?? [] %}

{% set params = params|merge({
    addbuttons: {
        get_mails: {
            text: _x('button', 'Get email tickets now'),
            add_attribs: {
                'data-block-on-unsaved': 'true',
            }
        }
    },
    formoptions: 'data-track-changes="true"'
}) %}

{% block form_fields %}
{% if item.fields['errors'] %}
    <div class="alert alert-danger">
        {{ __('%1$s: %2$s')|format(
            _n('Error', 'Errors', get_plural_number()),
            item.fields['errors']
        ) }}
    </div>
{% endif %}

    {{ fields.textField(
        'name',
        item.fields['name'],
        __('Name'), {
            helper: __('If the name is a valid email address, it will be automatically added to blacklisted senders.')
        }
    ) }}

    {{ fields.textareaField(
        'comment',
        item.fields['comment'],
        __('Comments')
    ) }}

    {{ fields.dropdownYesNo(
        'is_active',
        item.fields['is_active'],
        __('Active')
    ) }}

    {{ fields.nullField() }}

    {{ fields.smallTitle(__('Server configuration')) }}

    {% set host = item.fields['host'] %}
    {% set connect_opts = call(
        'Toolbox::parseMailServerConnectString',
        [host]
    ) %}

    {{ include('pages/setup/mailcollector/server_config_fields.html.twig', {
        'connect_opts': connect_opts,
        'connect_string': host,
        'protocol_choices': protocol_choices,
    }) }}

    {{ fields.smallTitle(__('Authentication')) }}

    {% set server_type = connect_opts['type'] is not empty ? ('/' ~ connect_opts['type']) : '' %}
    {% set is_oauth = oauth_applications[server_type] is defined %}

    {{ fields.textField(
        'login',
        item.fields['login'],
        __('Login'), {
            add_field_class: is_oauth ? 'd-none' : '',
            add_field_attribs: {
                'data-glpi-mailcollector-auth': 'password',
            },
        }
    ) }}

    {# With an OAuth application, the login is one of the mailboxes authorized on it. #}
    {% for oauth_type, oauth_application in oauth_applications %}
        {% set authorize_btn %}
            {% if oauth_application['can_authorize'] %}
                <button type="button" class="btn btn-outline-secondary ms-2 text-nowrap"
                        data-glpi-oauth-authorize="{{ oauth_application['id'] }}"
                        title="{{ __('Redirects to the provider to authorize a mailbox. Unsaved changes of this form will be lost.') }}">
                    <i class="ti ti-key" aria-hidden="true"></i>
                    {{ __('Authorize a mailbox') }}
                </button>
            {% endif %}
        {% endset %}
        {% set oauth_login_helper = oauth_application['has_emails'] ? __('Mailbox authorized on the OAuth application to collect emails from.') : __('No mailbox is authorized on this OAuth application yet.') %}
        {{ fields.dropdownArrayField(
            '_oauth_login_' ~ oauth_application['id'],
            item.fields['login'],
            oauth_application['emails'],
            __('Login'), {
                display_emptychoice: false,
                add_field_class: oauth_type == server_type ? '' : 'd-none',
                add_field_attribs: {
                    'data-glpi-mailcollector-auth': oauth_type,
                },
                add_field_html: authorize_btn,
                input_class: 'col-xxl-7 d-flex',
                helper: oauth_login_helper,
            }
        ) }}
    {% endfor %}

    {{ fields.nullField() }}

    {{ fields.passwordField(
        'passwd',
        '',
        __('Password'), {
            clearable: not item.isNewItem(),
            add_field_class: is_oauth ? 'd-none' : '',
            add_field_attribs: {
                'data-glpi-mailcollector-auth': 'password',
            },
            'additional_attributes': {
                'autocomplete': 'new-password',
            }
        }
    ) }}

    {% if connect_opts['type'] != 'pop' %}
        {{ fields.smallTitle(__('Folders setup')) }}
        {% set get_imap_folder_btn %}
            <div class="btn btn-outline-secondary get-imap-folder cursor-pointer{% if item.isNewItem() %} disabled{% endif %}"
                 {% if item.isNewItem() %}style="pointer-events: none;"{% endif %}>
                <i class="ti ti-list" aria-hidden="true"></i>
            </div>
        {% endset %}
        {# warning message when config is changed, choosing imap/folder is disabled #}
        <div class="alert alert-warning{% if not item.isNewItem() %} d-none{% endif %}" id="server-changed-warning">
            <i class="ti ti-info-circle" aria-hidden="true"></i>
            {{ __('Server configuration has changed. Please save the collector before browsing folders.') }}
        </div>
        {{ fields.textField(
            'server_mailbox',
            connect_opts['mailbox'],
            __('Incoming mail folder (optional, often INBOX)'), {
                add_field_html: get_imap_folder_btn,
                input_class: 'col-xxl-7 d-flex'
            }
        ) }}
        {{ fields.textField(
            'accepted',
            item.fields['accepted'],
            __('Accepted mail archive folder (optional)'), {
                add_field_html: get_imap_folder_btn,
                input_class: 'col-xxl-7 d-flex'
            }
        ) }}
        {{ fields.textField(
            'refused',
            item.fields['refused'],
            __('Refused mail archive folder (optional)'), {
                add_field_html: get_imap_folder_btn,
                input_class: 'col-xxl-7 d-flex'
            }
        ) }}
    {% endif %}

    {{ fields.smallTitle(__('Collection options')) }}
    {% set max_filesize_dropdown %}
        {% do call('MailCollector::showMaxFilesize', ['filesize_max', item.fields['filesize_max']]) %}
    {% endset %}
    {{ fields.htmlField(
        '',
        max_filesize_dropdown,
        __('Maximum size of each file imported by the mails receiver'),
        field_options
    ) }}
    {{ fields.dropdownYesNo(
        'use_mail_date',
        item.fields['use_mail_date'],
        __('Use mail date, instead of collect one')
    ) }}
    {{ fields.dropdownArrayField(
        'requester_field',
        item.fields['requester_field'], {
            (constant('MailCollector::REQUESTER_FIELD_FROM')): __('No'),
            (constant('MailCollector::REQUESTER_FIELD_REPLY_TO')): __('Yes'),
        },
        __('Use Reply-To as requester (when available)')
    ) }}
    {{ fields.dropdownYesNo(
        'add_to_to_observer',
        item.fields['add_to_to_observer'],
        __('Add TO users as observer')
    ) }}
    {{ fields.dropdownYesNo(
        'add_cc_to_observer',
        item.fields['add_cc_to_observer'],
        __('Add CC users as observer')
    ) }}
    {{ fields.dropdownYesNo(
        'collect_only_unread',
        item.fields['collect_only_unread'],
        __('Collect only unread mail')
    ) }}

    {% set create_user_helper %}
        {% if not config('is_users_auto_add') %}
            {{ __('If you use this option, and this collector is likely to receive requests from users authenticating via LDAP, we advise you to activate the option "Automatically add users from an external authentication source", in the Authentication settings in order to avoid the generation of duplicate users.') }}
        {% endif %}
    {% endset %}

    {{ fields.dropdownYesNo(
        'create_user_from_email',
        item.fields['create_user_from_email'],
        __('Automatically create user from email'), {
            helper: create_user_helper|trim|default(null)
        }
    ) }}

    {% if oauth_applications is not empty %}
        {% set oauth_specs = {} %}
        {% for oauth_type, oauth_application in oauth_applications %}
            {% set oauth_specs = oauth_specs|merge({(oauth_type): {
                id: oauth_application['id'],
                defaults: oauth_application['defaults'],
            }}) %}
        {% endfor %}
        <script>
            $(function() {
                const form = $('[data-glpi-mailcollector-auth="password"]').first().closest('form');
                const login = form.find('input[name="login"]');
                const oauth_specs = {{ oauth_specs|json_encode|raw }};

                // Shows the login/password fields, or the authorized mailboxes
                // of the OAuth application selected as server type.
                form.on('change', '[name="server_type"]', function() {
                    const type = $(this).val();
                    const spec = oauth_specs[type] ?? null;

                    form.find('[data-glpi-mailcollector-auth]').each(function() {
                        const auth = $(this).attr('data-glpi-mailcollector-auth');
                        $(this).toggleClass('d-none', spec !== null ? auth !== type : auth !== 'password');
                    });

                    if (spec === null) {
                        return;
                    }

                    login.val(form.find('[name="_oauth_login_' + spec.id + '"]').val() || '').trigger('change');

                    const server = form.find('[name="mail_server"]');
                    if (spec.defaults !== null && server.val() === '') {
                        server.val(spec.defaults.host).trigger('change');
                        form.find('[name="server_port"]').val(spec.defaults.port).trigger('change');
                        const ssl = spec.defaults.ssl.toUpperCase();
                        form.find('[name="server_ssl"]').val(ssl === 'SSL' ? '/ssl' : '').trigger('change');
                        form.find('[name="server_tls"]').val(ssl === 'TLS' ? '/tls' : '').trigger('change');
                    }
                });

                form.on('change', '[name^="_oauth_login_"]', function() {
                    login.val($(this).val() || '').trigger('change');
                });

                // Requests the authorization of a new mailbox, then comes back to this form.
                form.on('click', '[data-glpi-oauth-authorize]', function() {
                    const auth_form = $('<form>', {
                        method: 'post',
                        action: CFG_GLPI.root_doc + '/ajax/oauthauthorization_action.php',
                    });
                    const values = {
                        id: $(this).attr('data-glpi-oauth-authorize'),
                        type: '{{ constant('OAuthAuthorization::TYPE_IMAP')|e('js') }}',
                        request_authorization: 1,
                        return_url: '{{ (item.isNewItem() ? item.getFormURL(false) : item.getFormURLWithID(item.getID(), false))|e('js') }}',
                    };
                    $.each(values, function(name, value) {
                        auth_form.append($('<input>', {type: 'hidden', name: name, value: value}));
                    });
                    $('body').append(auth_form);
                    auth_form[0].submit();
                });
            });
        </script>
    {% endif %}

    {% if connect_opts['type'] != 'pop' %}
        <script>
            $(function() {
                // Track all fields used to establish the IMAP connection
                const connectionFields = [
                    // Server configuration
                    'mail_server', 'server_port', 'server_type', 'server_ssl',
                    'server_tls', 'server_cert', 'server_rsh', 'server_secure', 'server_debug',
                    // Authentication
                    'login', 'passwd'
                ];
                const form = $('.get-imap-folder').closest('form');
            {% if item.isNewItem() %}
                // New collector: always disabled until first save
                {% else %}
                const savedValues = {};
                connectionFields.forEach(function(name) {
                    const field = form.find('[name="' + name + '"]');
                    if (field.length) {
                        savedValues[name] = field.val();
                    }
                });

                function checkConnectionChanged() {
                    let changed = false;
                    connectionFields.forEach(function(name) {
                        const field = form.find('[name="' + name + '"]');
                        if (field.length && field.val() !== savedValues[name]) {
                            changed = true;
                        }
                    });
                    const warning = $('#server-changed-warning');
                    const buttons = form.find('.get-imap-folder');
                    if (changed) {
                        warning.removeClass('d-none');
                        buttons.addClass('disabled').css('pointer-events', 'none');
                    } else {
                        warning.addClass('d-none');
                        buttons.removeClass('disabled').css('pointer-events', '');
                    }
                }

                form.on(
                    'change input',
                    connectionFields.map(n => '[name="' + n + '"]').join(', '),
                    checkConnectionChanged
                );
                {% endif %}

            $(document).on('click', '.get-imap-folder', function() {
                const input = $(this).prev('input');

                const data = {
                    action: 'getFoldersList',
                    id: '{{ item.fields['id']|default(0)|e('js') }}',
                        input_id: input.attr('id')
                    };

                    glpi_ajax_dialog({
                        title: __('Select a folder'),
                        url: '{{ path('/ajax/mailcollector.php') }}',
                        params: data,
                        id: input.attr('id') + '_modal'
                    });
                });

                $(document).on('click', '.select_folder li', function(event) {
                    event.stopPropagation();

                    const li       = $(this);
                    const input_id = li.data('input-id');
                    const folder   = li.children('.folder-name').data('globalname');

                    $('#'+input_id).val(folder);

                    const modalEl = $('#'+input_id+'_modal')[0];
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    modal.hide();
                })
            });
        </script>
    {% endif %}
{% endblock %}
