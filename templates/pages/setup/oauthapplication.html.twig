{% import 'components/form/fields_macros.html.twig' as fields %}

{% set rand = random() %}

{# The provider dropdown has no empty choice, a new item is therefore rendered with the first provider selected. #}
{% set current_provider  = item.fields['provider']|default('') ?: providers|keys|first %}
{% set is_azure_provider = current_provider == constant('OAuthApplication::AZURE') %}

<div class="asset">
    {{ include('components/form/header.html.twig') }}

    {% set params        = params ?? [] %}
    {% set field_options = {} %}

    <div class="card-body d-flex flex-wrap">
        <div class="col-12 col-xxl-12 flex-column">
            <div class="d-flex flex-row flex-wrap flex-xl-nowrap">
                <div class="row flex-row align-items-start flex-grow-1">
                    <div class="row flex-row">
                        {% block form_fields %}
                            {{ fields.textField('name', item.fields['name'], __('Name')) }}

                            {{ fields.dropdownYesNo('is_active', item.fields['is_active'], __('Active')) }}

                            {{ fields.dropdownArrayField(
                                'provider',
                                item.fields['provider'],
                                providers,
                                __('Provider'),
                                {
                                    display_emptychoice: false,
                                    required: true,
                                    rand: rand,
                                }
                            ) }}

                            {{ fields.textField(
                                'client_id',
                                item.fields['client_id'],
                                __('Client ID'),
                                {
                                    required: true
                                }
                            ) }}

                            {{ fields.passwordField(
                                'client_secret',
                                item.fields['client_secret']|decrypt,
                                __('Client Secret'),
                                {
                                    is_disclosable: true,
                                    required: true
                                }
                            ) }}

                            {{ fields.textField(
                                'tenant_id',
                                item.fields['tenant_id'],
                                __('Tenant ID'),
                                {
                                    helper: __('Required for Microsoft Azure (directory/tenant ID)'),
                                    required: true,
                                    add_field_class: is_azure_provider ? '' : 'd-none',
                                    add_field_attribs: {
                                        id: 'tenant_id_field' ~ rand,
                                    },
                                }
                            ) }}

                            {{ fields.textareaField(
                                'comment',
                                item.fields['comment'],
                                _n('Comment', 'Comments', get_plural_number()),
                                field_options
                            ) }}
                        {% endblock %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% set buttons_params = params %}
    {% if not item.isNewItem() %}
        {# Rendered after the standard buttons: the footer is laid out in reverse,
           so this appears on their left. #}
        {% set buttons_params = params|merge({
            'addbuttons': {
                'test_connection': {
                    'type': 'button',
                    'btn_class': 'btn-outline-secondary',
                    'icon': 'ti ti-stethoscope',
                    'text': __('Test connection'),
                    'add_attribs': {
                        'data-bs-toggle': 'modal',
                        'data-bs-target': '#oauth_diagnostic_' ~ rand,
                    },
                },
            },
        }) %}
    {% endif %}

    {{ include('components/form/buttons.html.twig', {'params': buttons_params}) }}
</div>

{% if not item.isNewItem() %}
    <div class="modal fade" id="oauth_diagnostic_{{ rand }}" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="ti ti-stethoscope me-1"></i>
                        {{ __('Connection diagnostic') }}
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ __('Close') }}"></button>
                </div>
                <div class="modal-body">
                    <div class="oauth-diagnostic-tree" id="oauth_diagnostic_tree_{{ rand }}"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" id="oauth_diagnostic_rerun_{{ rand }}">
                        <i class="ti ti-refresh me-1"></i>
                        {{ __('Run again') }}
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ __('Close') }}</button>
                </div>
            </div>
        </div>
    </div>

    <style>
        .oauth-diagnostic-tree ul {
            list-style: none;
            margin: 0;
            padding-left: 1.5rem;
        }
        .oauth-diagnostic-tree > ul {
            padding-left: 0;
        }
        .oauth-diagnostic-tree li {
            position: relative;
            padding: .35rem 0 .35rem 1.5rem;
        }
        .oauth-diagnostic-tree > ul > li {
            padding-left: 0;
        }
        /* Elbow connector joining a node to its parent. */
        .oauth-diagnostic-tree li::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            height: 1.25rem;
            width: 1rem;
            border-left: 1px solid var(--tblr-border-color);
            border-bottom: 1px solid var(--tblr-border-color);
            border-bottom-left-radius: .25rem;
        }
        /* Vertical line continuing down to the next sibling. */
        .oauth-diagnostic-tree li::after {
            content: '';
            position: absolute;
            left: 0;
            top: 1.25rem;
            bottom: 0;
            border-left: 1px solid var(--tblr-border-color);
        }
        .oauth-diagnostic-tree li:last-child::after,
        .oauth-diagnostic-tree > ul > li::before,
        .oauth-diagnostic-tree > ul > li::after {
            display: none;
        }
        .oauth-diagnostic-tree .oauth-diagnostic-node {
            display: flex;
            align-items: flex-start;
            gap: .5rem;
        }
        .oauth-diagnostic-tree .oauth-diagnostic-icon {
            flex: 0 0 1.25rem;
            line-height: 1.4;
            text-align: center;
        }
        .oauth-diagnostic-tree li.oauth-diagnostic-skipped {
            opacity: .5;
        }
        /* Diagnostic messages may span several lines (server response, hints). */
        .oauth-diagnostic-tree .oauth-diagnostic-message {
            white-space: pre-line;
        }
    </style>

    <script>
        (function () {
            const modal_el = document.getElementById('oauth_diagnostic_{{ rand }}');
            const tree_el  = document.getElementById('oauth_diagnostic_tree_{{ rand }}');
            const rerun_el = document.getElementById('oauth_diagnostic_rerun_{{ rand }}');

            const endpoint = '{{ config('root_doc')|e('js') }}/ajax/oauthapplication_diagnostic.php';
            const app_id   = {{ item.getID() }};

            const i18n = {
                pending: '{{ __('Pending')|e('js') }}',
                running: '{{ __('Checking...')|e('js') }}',
                skipped: '{{ __('Skipped because the previous step failed')|e('js') }}',
                failed:  '{{ __('Failed')|e('js') }}',
                error:   '{{ __('Unable to run the diagnostic')|e('js') }}',
            };

            // Statuses that allow child steps to run.
            const CONTINUES = ['ok', 'warning', 'info'];

            const ICONS = {
                pending: '<i class="ti ti-circle-dotted text-muted"></i>',
                running: '<span class="spinner-border spinner-border-sm text-primary" role="status"></span>',
                ok:      '<i class="ti ti-circle-check text-success"></i>',
                failed:  '<i class="ti ti-circle-x text-danger"></i>',
                warning: '<i class="ti ti-alert-triangle text-warning"></i>',
                info:    '<i class="ti ti-info-circle text-info"></i>',
                skipped: '<i class="ti ti-minus text-muted"></i>',
            };

            let running = false;

            async function post(data) {
                const body = new FormData();
                body.append('id', app_id);
                Object.entries(data).forEach(([key, value]) => body.append(key, value));

                const response = await fetch(endpoint, {
                    method: 'POST',
                    body: body,
                    credentials: 'same-origin',
                });
                if (!response.ok) {
                    throw new Error('HTTP ' + response.status);
                }
                return await response.json();
            }

            function buildNode(step) {
                const li = document.createElement('li');
                li.dataset.step = step.key;
                li.innerHTML = '<div class="oauth-diagnostic-node">'
                    + '<span class="oauth-diagnostic-icon"></span>'
                    + '<div class="flex-fill">'
                    + '<div class="oauth-diagnostic-label"></div>'
                    + '<div class="oauth-diagnostic-message text-muted small"></div>'
                    + '</div></div>';
                li.querySelector('.oauth-diagnostic-label').textContent = step.label;
                return li;
            }

            /**
             * Renders the flat, parent-referencing step list.
             *
             * The leading steps form a single-child chain of prerequisites:
             * they are listed in line, since nesting them would only produce a
             * staircase without conveying anything. Nesting starts at the first
             * step that branches out (the client credentials, under which each
             * authorization is checked independently).
             */
            function renderTree(steps) {
                const children = new Map();
                steps.forEach((step) => {
                    const parent = step.parent === null ? '' : step.parent;
                    if (!children.has(parent)) {
                        children.set(parent, []);
                    }
                    children.get(parent).push(step);
                });

                const buildList = (parent_key) => {
                    const list = children.get(parent_key) || [];
                    if (list.length === 0) {
                        return null;
                    }
                    const ul = document.createElement('ul');
                    list.forEach((step) => {
                        const li = buildNode(step);
                        const sub = buildList(step.key);
                        if (sub !== null) {
                            li.appendChild(sub);
                        }
                        ul.appendChild(li);
                    });
                    return ul;
                };

                tree_el.replaceChildren();

                const root = document.createElement('ul');
                let parent_key = '';
                let next = children.get('') || [];
                let last_li = null;

                while (next.length === 1) {
                    last_li = buildNode(next[0]);
                    root.appendChild(last_li);
                    parent_key = next[0].key;
                    next = children.get(parent_key) || [];
                }

                if (next.length > 0) {
                    const branch = buildList(parent_key);
                    if (branch !== null) {
                        (last_li !== null ? last_li : root).appendChild(branch);
                    }
                }

                tree_el.appendChild(root);

                steps.forEach((step) => setState(step.key, 'pending', i18n.pending));
            }

            function setState(key, status, message) {
                const li = tree_el.querySelector('[data-step="' + CSS.escape(key) + '"]');
                if (li === null) {
                    return;
                }
                li.classList.toggle('oauth-diagnostic-skipped', status === 'skipped');
                li.querySelector('.oauth-diagnostic-icon').innerHTML = ICONS[status] || ICONS.pending;
                li.querySelector('.oauth-diagnostic-message').textContent = message || '';
            }

            async function run() {
                if (running) {
                    return;
                }
                running = true;
                rerun_el.disabled = true;

                try {
                    let steps;
                    try {
                        steps = (await post({action: 'plan'})).steps;
                    } catch (error) {
                        tree_el.replaceChildren();
                        const alert = document.createElement('div');
                        alert.className = 'alert alert-danger mb-0';
                        alert.textContent = i18n.error + ' (' + error.message + ')';
                        tree_el.appendChild(alert);
                        return;
                    }

                    renderTree(steps);

                    const statuses = {};
                    for (const step of steps) {
                        if (step.parent !== null && !CONTINUES.includes(statuses[step.parent])) {
                            statuses[step.key] = 'skipped';
                            setState(step.key, 'skipped', i18n.skipped);
                            continue;
                        }

                        setState(step.key, 'running', i18n.running);
                        try {
                            const result = await post({action: 'step', step: step.key});
                            statuses[step.key] = result.status;
                            setState(step.key, result.status, result.message);
                        } catch (error) {
                            statuses[step.key] = 'failed';
                            setState(step.key, 'failed', i18n.failed + ' (' + error.message + ')');
                        }
                    }
                } finally {
                    running = false;
                    rerun_el.disabled = false;
                }
            }

            modal_el.addEventListener('shown.bs.modal', run);
            rerun_el.addEventListener('click', run);
        })();
    </script>
{% endif %}

<script>
    $(() => {
        const provider_dropdown = $('#dropdown_provider{{ rand }}');
        const tenant_field      = $('#tenant_id_field{{ rand }}');

        const toggleTenantField = () => {
            const is_azure = provider_dropdown.val() === '{{ constant('OAuthApplication::AZURE')|e('js') }}';

            tenant_field.toggleClass('d-none', !is_azure);
            // A hidden required input would prevent the form from being submitted.
            tenant_field.find('[name="tenant_id"]').prop('required', is_azure);
        };

        provider_dropdown.on('change', toggleTenantField);
        toggleTenantField();
    });
</script>
