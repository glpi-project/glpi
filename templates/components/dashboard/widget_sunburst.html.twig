<style>
    #{{ chart_id|e('css') }} {
        background-color: {{ bg_color|e('css') }};
        color: {{ fg_color|e('css') }};
    }

    .theme-dark #{{ chart_id|e('css') }} {
        background-color: {{ dark_bg_color|e('css') }};
        color: {{ dark_fg_color|e('css') }};
    }
</style>
<div class="card g-chart sunburst {{ class }}" id="{{ chart_id }}" data-testid="dashboard-widget">
    <div class="chart ct-chart">
        {% if nodata %}
            <span class="empty-card no-data">
                <div>{{ __('No data found') }}</div>
            </span>
        {% endif %}
    </div>
    <span class="main-label" title="{{ label }}">{{ label }}</span>
    <i class="main-icon {{ icon }}" aria-hidden="true"></i>
</div>

{% if not nodata %}
    <script type="module">
        const chart_options = {{ options|json_encode|raw }};
        const open_url = (params) => {
            const data_url = _.get(params, 'data.url', '');
            if (data_url.length > 0) {
                window.location.href = data_url;
            }
        };

        // Look for the card in every dashboard, the response may target a dashboard that is not visible
        document.querySelectorAll('[id="{{ chart_id|e('js') }}"] .chart').forEach((target) => {
            if (target.hasAttribute('_echarts_instance_')) {
                return;
            }

            const chart = echarts.init(target);
            chart.setOption(chart_options);
            // A chart initialized in a hidden dashboard has no size, render it again once displayed
            new ResizeObserver(() => {
                if (!chart.isDisposed()) {
                    chart.resize();
                }
            }).observe(target);
            // A click on a node with sub-nodes zooms into it (or back, on the center), on a leaf it opens its search
            chart.on('click', (params) => {
                if (_.get(params, 'data.children', []).length === 0) {
                    open_url(params);
                }
            });
            // A double click opens the search of any node
            chart.on('dblclick', open_url);

            $(target).on('mouseover', () => {
                chart.setOption({'toolbox': {'show': true}});
            }).on('mouseout', () => {
                chart.setOption({'toolbox': {'show': false}});
            });
        });
    </script>
{% endif %}
