{% import 'components/form/fields_macros.html.twig' as fields %}

{# Same form as the answer to an approval request: always open, the comment is required to refuse #}
<form method="post" action="{{ 'ITILFollowup'|itemtype_form_path }}" class="mt-2" data-submit-once data-testid="solution-approval-form">
   <input type="hidden" name="itemtype" value="{{ item.getType() }}" />
   <input type="hidden" name="items_id" value="{{ item.fields['id'] }}" />
   <input type="hidden" name="requesttypes_id" value="0" />

   {% if with_separator ?? false %}
      <hr class="my-2" />
   {% endif %}
   <div class="mb-3 comment-part">
      {{ fields.textareaField(
         'content',
         '',
         _n('Comment', 'Comments', 1),
         {
            'full_width': true,
            'helper': __('Optional when approved'),
            'enable_richtext': true,
            'enable_fileupload': true,
            'entities_id': item.fields['entities_id'],
            'is_horizontal': false,
            'rand': rand,
         }
      ) }}
   </div>

   <hr class="my-2" />
   <div class="validation-footer">
      <button type="submit" class="btn btn-outline-red" name="add_reopen">
         <i class="ti ti-thumb-down" aria-hidden="true"></i>
         <span class="validation-label">{{ __('Refuse') }}</span>
      </button>
      <button type="submit" class="btn btn-outline-green" name="add_close">
         <i class="ti ti-thumb-up" aria-hidden="true"></i>
         <span class="validation-label">{{ __('Approve') }}</span>
      </button>
   </div>
</form>
