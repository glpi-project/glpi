{# Actions added by plugins to a timeline entry, see CommonITILObject::getTimelineItemPluginActions() #}

{# Icon buttons, next to the menu of the entry (the label is displayed when there is no icon) #}
{% macro buttons(actions) %}
   {% for action in actions %}
      {% set attributes = call('Html::parseAttributes', {options: action['attributes']}) %}
      {% set content %}
         {% if action['icon'] %}
            <i class="{{ action['icon'] }}" aria-hidden="true"></i>
            <span class="visually-hidden">{{ action['label'] }}</span>
         {% else %}
            <span>{{ action['label'] }}</span>
         {% endif %}
      {% endset %}
      {% set class = 'btn btn-sm btn-ghost-secondary timeline-item-action ' ~ (action['icon'] ? 'timeline-item-action-icon ' : '') ~ action['class'] %}
      {% if action['url'] is not null %}
         <a class="{{ class }}" href="{{ action['url'] }}" title="{{ action['label'] }}" data-bs-toggle="tooltip" {{ attributes|raw }}>{{ content }}</a>
      {% else %}
         <button type="button" class="{{ class }}" title="{{ action['label'] }}" data-bs-toggle="tooltip" {{ attributes|raw }}>{{ content }}</button>
      {% endif %}
   {% endfor %}
{% endmacro %}

{# Items of the menu of the entry #}
{% macro menu_items(actions) %}
   {% for action in actions %}
      {% set attributes = call('Html::parseAttributes', {options: action['attributes']}) %}
      <li>
         {% if action['url'] is not null %}
            <a class="dropdown-item {{ action['class'] }}" href="{{ action['url'] }}" {{ attributes|raw }}>
               {% if action['icon'] %}<i class="{{ action['icon'] }}" aria-hidden="true"></i>{% endif %}
               <span>{{ action['label'] }}</span>
            </a>
         {% else %}
            <button type="button" class="dropdown-item {{ action['class'] }}" {{ attributes|raw }}>
               {% if action['icon'] %}<i class="{{ action['icon'] }}" aria-hidden="true"></i>{% endif %}
               <span>{{ action['label'] }}</span>
            </button>
         {% endif %}
      </li>
   {% endfor %}
{% endmacro %}
